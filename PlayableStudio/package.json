    "@gltf-transform/functions": "^4.5.1",
    "fbx2gltf": "^0.9.7-p1",
    "js-yaml": "^5.5.0",
    "jszip": "^3.10.2",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
}