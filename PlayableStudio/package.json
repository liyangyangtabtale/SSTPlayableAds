{
  "name": "playable-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Super Stylist 3D 换装试玩：运行时 + Studio 控制面板 + Unity 资源导出工具",
  "scripts": {
    "dev:runtime": "node tools/build-dev-data.mjs && vite --config vite.runtime.config.js",
